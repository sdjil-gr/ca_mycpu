+reg        data_sram_wr_MEM;
+reg [1:0]  data_sram_size_EX;
+reg [1:0]  data_sram_size_MEM;
+reg [ 3:0] data_sram_wstrb_EX;
+reg [ 3:0] data_sram_wstrb_MEM;
