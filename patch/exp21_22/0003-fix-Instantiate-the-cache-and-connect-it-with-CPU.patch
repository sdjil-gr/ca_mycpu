diff --git a/myCPU/mycpu_top.v b/myCPU/mycpu_top.v
index 919ddc2..e26a077 100644
--- a/myCPU/mycpu_top.v
+++ b/myCPU/mycpu_top.v
@@ -1,3 +1,29 @@
+//*************************************************************************
+//   > File Name   : mycpu_top.v
+//   > Description : included cpu_core, 1 x 2 axi_bridge,
+//                   icache, dcache.
+// 
+//           -------------------------------
+//           |           cpu_core          |
+//           -------------------------------
+//               | inst               | data
+//               |                    | 
+//         --------------       --------------
+//         |   icache   |       |   dcache   |
+//         --------------       --------------
+//               |                    |           
+//               |                    |           
+//         -----------------------------------
+//         |          axi_2x1_bridge         |
+//         -----------------------------------
+//                          |
+//                          | axi interface
+//                          |
+//
+//   > Author      : Sun Guangrun (group18)
